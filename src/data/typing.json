{
  "brand": "tapline",
  "tagline": "a typing test",
  "description": "A minimal typing speed test. Time and word modes, punctuation, numbers, live WPM and a results chart.",
  "defaults": {
    "mode": "time",
    "time": 30,
    "words": 25,
    "punct": false,
    "nums": false
  },
  "options": {
    "time": [
      15,
      30,
      60,
      120
    ],
    "words": [
      10,
      25,
      50,
      100
    ]
  },
  "generation": {
    "numberChance": 0.12,
    "smallNumberMax": 100,
    "largeNumberMax": 10000,
    "timeModeWordCount": 80,
    "refillThreshold": 40,
    "refillCount": 60,
    "maxOvertype": 10,
    "punctuation": [
      {
        "upTo": 0.08,
        "suffix": "."
      },
      {
        "upTo": 0.15,
        "suffix": ","
      },
      {
        "upTo": 0.17,
        "suffix": "?"
      },
      {
        "upTo": 0.19,
        "suffix": "!"
      },
      {
        "upTo": 0.205,
        "suffix": ";"
      },
      {
        "upTo": 0.22,
        "suffix": ":"
      },
      {
        "upTo": 0.24,
        "wrap": [
          "\"",
          "\""
        ]
      },
      {
        "upTo": 0.25,
        "wrap": [
          "(",
          ")"
        ]
      },
      {
        "upTo": 0.26,
        "suffix": "'s"
      }
    ],
    "sentenceEnd": ".?!"
  },
  "storageKeys": {
    "config": "tapline:cfg",
    "personalBest": "tapline:pb"
  },
  "personalBest": {
    "minAccuracy": 50
  },
  "hints": [
    {
      "keys": [
        "tab"
      ],
      "alt": [
        "esc"
      ],
      "label": "restart",
      "desktopOnly": false
    },
    {
      "keys": [
        "ctrl",
        "backspace"
      ],
      "label": "delete word",
      "desktopOnly": true
    },
    {
      "keys": [
        "enter"
      ],
      "label": "next test on results",
      "desktopOnly": true
    }
  ],
